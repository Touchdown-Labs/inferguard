# Required
TARGET_ENDPOINT=http://localhost:8000

# Upstash Redis (REST API)
UPSTASH_REDIS_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_TOKEN=AX...your_token

# Upstash Vector (REST API)
UPSTASH_VECTOR_URL=https://YOUR_VECTOR.upstash.io
UPSTASH_VECTOR_TOKEN=AX...your_token

# Diagnosis provider (GMI Cloud)
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_API_KEY=gmi-...             # Primary diagnosis credential
GMI_MODEL=openai/gpt-oss-120b

# Legacy compatibility aliases (read only if GMI_* is unset)
# LLM_BASE_URL=https://api.gmi-serving.com/v1
# LLM_API_KEY=gmi-...
# LLM_MODEL=openai/gpt-oss-120b

# Thresholds
KV_ALERT_THRESHOLD=0.85
TTFT_ALERT_MULTIPLIER=2.0
POLL_INTERVAL_SECONDS=30

# Brain mode
INFERGUARD_BRAIN_MODE=local
# Reserved for future remote mode
# INFERGUARD_BRAIN_AGENT_NAME=inferguard-brain
INFERGUARD_PROACTIVE_CYCLE_EVERY=5

# Future-only Blaxel credential (not used by the current local runtime path)
# BL_API_KEY=

# Replay validation (optional)
# INFERGUARD_REPLAY_EXPORT_FILE=
# INFERGUARD_REPLAY_MAX_CONCURRENCY=4
# INFERGUARD_REPLAY_MAX_SESSIONS=0
# INFERGUARD_REPLAY_RUNTIME_STACK_ID=
# INFERGUARD_REPLAY_SKIP_TOKENIZER=true

# Actuation (default: off)
INFERGUARD_ACTUATION_MODE=off
# INFERGUARD_ACTUATION_ENDPOINT=
# INFERGUARD_ACTUATION_ALLOWLIST=
# INFERGUARD_ACTUATION_VERIFY_DELAY=60

# Daytona (optional, stub L4 canary path)
# DAYTONA_API_KEY=
